if(NOT BUILD_GAME_LIBRARIES AND NOT BUILD_GAME_QVMS AND NOT CMAKE_SYSTEM_NAME STREQUAL "PS3")
    return()
endif()

include(utils/set_output_dirs)
include(shared_script)

file(GLOB_RECURSE BG_SOURCES
    ${SOURCE_DIR}/fgame/bg_misc.cpp
    ${SOURCE_DIR}/fgame/bg_pmove.cpp
    ${SOURCE_DIR}/fgame/bg_slidemove.cpp
    ${SOURCE_DIR}/fgame/bg_voteoptions.cpp
)

file(GLOB_RECURSE CGAME_SOURCES
    ${SOURCE_DIR}/cgame/*.c ${SOURCE_DIR}/cgame/*.cpp
)

set(CGAME_BINARY_SOURCES)
set(CGAME_QVM_SOURCES)

file(GLOB_RECURSE GAME_SOURCES
    ${SOURCE_DIR}/fgame/*.c ${SOURCE_DIR}/fgame/*.cpp
    ${SOURCE_DIR}/script/*.c ${SOURCE_DIR}/script/*.cpp
	${SOURCE_DIR}/parser/parsetree.cpp
)

# Compile lexer and grammar files.  PS3 is a target build, but the parser
# itself must still be generated by the host Bison/Flex tools.
set(PARSER_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/parser/generated")
file(MAKE_DIRECTORY "${PARSER_GENERATED_DIR}")

flex_target(fgame-lexer
    ${CMAKE_SOURCE_DIR}/code/parser/lex_source.txt
    ${PARSER_GENERATED_DIR}/yyLexer.cpp
    DEFINES_FILE ${PARSER_GENERATED_DIR}/yyLexer.h
    COMPILE_FLAGS "-Cem --nounistd")

bison_target(fgame-parser
    ${CMAKE_SOURCE_DIR}/code/parser/bison_source.txt
    ${PARSER_GENERATED_DIR}/yyParser.cpp
    DEFINES_FILE ${PARSER_GENERATED_DIR}/yyParser.hpp)

add_flex_bison_dependency(fgame-lexer fgame-parser)

list(APPEND GAME_SOURCES
    ${BISON_fgame-parser_OUTPUTS}
    ${FLEX_fgame-lexer_OUTPUTS})

set(GAME_BINARY_SOURCES)
set(GAME_QVM_SOURCES)

set(UI_SOURCES)

set(UI_BINARY_SOURCES)
set(UI_QVM_SOURCES)

set(GAME_MODULE_SHARED_SOURCES
    ${SOURCE_DIR}/qcommon/q_math.c
    ${SOURCE_DIR}/qcommon/q_shared.c
    ${SCRIPT_SYSTEM_SOURCES}
)

set(CGAME_SOURCES_BASEGAME ${CGAME_SOURCES} ${GAME_MODULE_SHARED_SOURCES})
set(GAME_SOURCES_BASEGAME ${GAME_SOURCES} ${GAME_MODULE_SHARED_SOURCES})
set(UI_SOURCES_BASEGAME ${UI_SOURCES} ${GAME_MODULE_SHARED_SOURCES})

if(CMAKE_SYSTEM_NAME STREQUAL "PS3")
    # OpenMoHAA normally loads game/cgame shared libraries.  PS3 does not
    # have that runtime loader in the port, so build each module as a group
    # of relocatable objects and attach the resulting objects to the client.
    set(PS3_GAME_OBJ_TARGET "openmohaa_game_objects")
    set(PS3_CGAME_OBJ_TARGET "openmohaa_cgame_objects")

    add_library(${PS3_GAME_OBJ_TARGET} OBJECT
        ${GAME_SOURCES_BASEGAME}
        ${BG_SOURCES}
        ${GAME_BINARY_SOURCES}
    )
    target_compile_definitions(${PS3_GAME_OBJ_TARGET} PRIVATE GAME_DLL WITH_SCRIPT_ENGINE ARCHIVE_SUPPORTED)
    target_include_directories(${PS3_GAME_OBJ_TARGET} PRIVATE
        ${SOURCE_DIR}/fgame
        ${SOURCE_DIR}/script
        ${SOURCE_DIR}/parser
        ${PARSER_GENERATED_DIR}
        ${SOURCE_DIR}/thirdparty/recastnavigation/Recast/Include
        ${SOURCE_DIR}/thirdparty/recastnavigation/Detour/Include
        ${SOURCE_DIR}/thirdparty/recastnavigation/DetourCrowd/Include
    )
    set_target_properties(${PS3_GAME_OBJ_TARGET} PROPERTIES POSITION_INDEPENDENT_CODE OFF)

    add_library(${PS3_CGAME_OBJ_TARGET} OBJECT
        ${CGAME_SOURCES_BASEGAME}
        ${BG_SOURCES}
        ${CGAME_BINARY_SOURCES}
    )
    target_compile_definitions(${PS3_CGAME_OBJ_TARGET} PRIVATE CGAME_DLL)
    target_include_directories(${PS3_CGAME_OBJ_TARGET} PRIVATE ${SOURCE_DIR}/cgame ${SOURCE_DIR}/fgame ${SOURCE_DIR}/script ${SOURCE_DIR}/parser ${PARSER_GENERATED_DIR})
    set_target_properties(${PS3_CGAME_OBJ_TARGET} PROPERTIES POSITION_INDEPENDENT_CODE OFF)

    set(PS3_MODULE_DIR "${CMAKE_CURRENT_BINARY_DIR}/ps3modules")
    file(MAKE_DIRECTORY "${PS3_MODULE_DIR}")
    set(PS3_GAME_PARTIAL "${PS3_MODULE_DIR}/game_partial.o")
    set(PS3_GAME_NATIVE  "${PS3_MODULE_DIR}/game_native.o")
    set(PS3_CGAME_PARTIAL "${PS3_MODULE_DIR}/cgame_partial.o")
    set(PS3_CGAME_NATIVE  "${PS3_MODULE_DIR}/cgame_native.o")

    # CMake expands $<TARGET_OBJECTS:...> as one semicolon-delimited command
    # argument under Ninja/VERBATIM. Build archives first, then use ld's
    # whole-archive mode for the relocatable partial link. This keeps the
    # module link reproducible with real GNU/PS3 linkers.
    add_library(${PS3_GAME_OBJ_TARGET}_archive STATIC
        $<TARGET_OBJECTS:${PS3_GAME_OBJ_TARGET}>
    )
    add_library(${PS3_CGAME_OBJ_TARGET}_archive STATIC
        $<TARGET_OBJECTS:${PS3_CGAME_OBJ_TARGET}>
    )
    set_target_properties(${PS3_GAME_OBJ_TARGET}_archive ${PS3_CGAME_OBJ_TARGET}_archive
        PROPERTIES POSITION_INDEPENDENT_CODE OFF
    )

    add_custom_command(
        OUTPUT ${PS3_GAME_NATIVE}
        COMMAND ${CMAKE_LINKER} -r -o ${PS3_GAME_PARTIAL}
                --whole-archive $<TARGET_FILE:${PS3_GAME_OBJ_TARGET}_archive>
                --no-whole-archive
        COMMAND ${CMAKE_COMMAND} -E env PYTHONPATH="${CMAKE_SOURCE_DIR}/cmake"
            ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/cmake/ps3_localize_module.py
            --nm ${CMAKE_NM}
            --objcopy ${CMAKE_OBJCOPY}
            --input ${PS3_GAME_PARTIAL}
            --output ${PS3_GAME_NATIVE}
            --keep GetGameAPI
            --weak-prefix __ps3game_
        DEPENDS ${PS3_GAME_OBJ_TARGET}_archive ${CMAKE_SOURCE_DIR}/cmake/ps3_localize_module.py
        VERBATIM
    )

    add_custom_command(
        OUTPUT ${PS3_CGAME_NATIVE}
        COMMAND ${CMAKE_LINKER} -r -o ${PS3_CGAME_PARTIAL}
                --whole-archive $<TARGET_FILE:${PS3_CGAME_OBJ_TARGET}_archive>
                --no-whole-archive
        COMMAND ${CMAKE_COMMAND} -E env PYTHONPATH="${CMAKE_SOURCE_DIR}/cmake"
            ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/cmake/ps3_localize_module.py
            --nm ${CMAKE_NM}
            --objcopy ${CMAKE_OBJCOPY}
            --input ${PS3_CGAME_PARTIAL}
            --output ${PS3_CGAME_NATIVE}
            --keep GetCGameAPI
            --weak-prefix __ps3cgame_
        DEPENDS ${PS3_CGAME_OBJ_TARGET}_archive ${CMAKE_SOURCE_DIR}/cmake/ps3_localize_module.py
        VERBATIM
    )

    add_custom_target(openmohaa_ps3_modules DEPENDS ${PS3_GAME_NATIVE} ${PS3_CGAME_NATIVE})
    add_dependencies(${CLIENT_BINARY} openmohaa_ps3_modules)
    target_sources(${CLIENT_BINARY} PRIVATE ${PS3_GAME_NATIVE} ${PS3_CGAME_NATIVE})
    target_link_libraries(${CLIENT_BINARY} PRIVATE RecastNavigation::Detour RecastNavigation::DetourCrowd RecastNavigation::Recast)

elseif(BUILD_GAME_LIBRARIES)
    set(CGAME_MODULE_BINARY ${CGAME_MODULE})
    set(GAME_MODULE_BINARY ${GAME_MODULE})
    set(UI_MODULE_BINARY ${UI_MODULE})

    if (BASEGAME)
        set(CGAME_MODULE_BINARY_BASEGAME ${CGAME_MODULE_BINARY}_${BASEGAME})
        set(GAME_MODULE_BINARY_BASEGAME ${GAME_MODULE_BINARY}_${BASEGAME})
        set(UI_MODULE_BINARY_BASEGAME ${UI_MODULE_BINARY}_${BASEGAME})
    else()
        set(CGAME_MODULE_BINARY_BASEGAME ${CGAME_MODULE_BINARY})
        set(GAME_MODULE_BINARY_BASEGAME ${GAME_MODULE_BINARY})
        set(UI_MODULE_BINARY_BASEGAME ${UI_MODULE_BINARY})
    endif()

    add_library(                ${CGAME_MODULE_BINARY_BASEGAME} SHARED ${CGAME_SOURCES_BASEGAME} ${BG_SOURCES} ${CGAME_BINARY_SOURCES})
    target_compile_definitions( ${CGAME_MODULE_BINARY_BASEGAME} PRIVATE CGAME_DLL)
    target_link_libraries(      ${CGAME_MODULE_BINARY_BASEGAME} PRIVATE ${COMMON_LIBRARIES})
    set_target_properties(      ${CGAME_MODULE_BINARY_BASEGAME} PROPERTIES OUTPUT_NAME ${CGAME_MODULE_BINARY})
    set_output_dirs(            ${CGAME_MODULE_BINARY_BASEGAME} SUBDIRECTORY ${BASEGAME})

    INSTALL(TARGETS ${CGAME_MODULE_BINARY_BASEGAME} DESTINATION ${INSTALL_LIBDIR_FULL})

    if(MSVC)
        INSTALL(FILES $<TARGET_PDB_FILE:${CGAME_MODULE_BINARY_BASEGAME}> DESTINATION ${INSTALL_LIBDIR_FULL} OPTIONAL)
    endif()

    add_library(                ${GAME_MODULE_BINARY_BASEGAME} SHARED ${GAME_SOURCES_BASEGAME} ${BG_SOURCES} ${GAME_BINARY_SOURCES})
    target_compile_definitions( ${GAME_MODULE_BINARY_BASEGAME} PRIVATE GAME_DLL WITH_SCRIPT_ENGINE ARCHIVE_SUPPORTED)
    target_link_libraries(      ${GAME_MODULE_BINARY_BASEGAME} PRIVATE RecastNavigation::Detour RecastNavigation::DetourCrowd RecastNavigation::Recast)
    target_link_libraries(      ${GAME_MODULE_BINARY_BASEGAME} PRIVATE ${COMMON_LIBRARIES})
    set_target_properties(      ${GAME_MODULE_BINARY_BASEGAME} PROPERTIES OUTPUT_NAME ${GAME_MODULE_BINARY})
    set_output_dirs(            ${GAME_MODULE_BINARY_BASEGAME} SUBDIRECTORY ${BASEGAME})

    INSTALL(TARGETS ${GAME_MODULE_BINARY_BASEGAME} DESTINATION ${INSTALL_LIBDIR_FULL})

    if(MSVC)
        INSTALL(FILES $<TARGET_PDB_FILE:${GAME_MODULE_BINARY_BASEGAME}> DESTINATION ${INSTALL_LIBDIR_FULL} OPTIONAL)
    endif()

    #add_library(                ${UI_MODULE_BINARY_BASEGAME} SHARED ${UI_SOURCES_BASEGAME} ${UI_BINARY_SOURCES})
    #target_compile_definitions( ${UI_MODULE_BINARY_BASEGAME} PRIVATE UI)
    #set_target_properties(      ${UI_MODULE_BINARY_BASEGAME} PROPERTIES OUTPUT_NAME ${UI_MODULE_BINARY})
    #set_output_dirs(            ${UI_MODULE_BINARY_BASEGAME} SUBDIRECTORY ${BASEGAME})
endif()
